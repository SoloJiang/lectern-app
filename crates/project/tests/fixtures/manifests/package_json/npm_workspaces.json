{
  "name": "acme-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Sanitized sample: npm 7+ workspaces at the repository root.",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/eslint-config",
    "!packages/legacy-*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "typescript": "~5.6.2"
  },
  "config": {
    "workspaces": "a nested key, not the top-level field"
  },
  "engines": {
    "node": ">=20"
  }
}
