{"on":"initialize","do":[{"reply":{"protocolVersion":1,"agentCapabilities":{"loadSession":true}}}]}
{"on":"session/load","do":[{"send":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"$SESSION","update":{"sessionUpdate":"user_message_chunk","content":{"type":"text","text":"an old prompt"}}}}},{"send":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"$SESSION","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"an old reply"}}}}},{"send":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"$SESSION","update":{"sessionUpdate":"usage_update","used":1,"size":2}}}},{"reply":{}}]}
{"on":"session/prompt","do":[{"send":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"$SESSION","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"fresh answer"}}}}},{"reply":{"stopReason":"end_turn"}}]}
