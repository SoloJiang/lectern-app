#!/usr/bin/env python3
"""Fake rustc for test_check_architecture.py. Appends its arguments and
working directory to $FAKE_RUSTC_LOG (the checker sends rustc no input) and
replays rustc.json next to it; never runs the real compiler."""
import json
import os
import sys

here = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(here, "rustc.json")) as f:
    fixture = json.load(f)
args = sys.argv[1:]
with open(os.environ["FAKE_RUSTC_LOG"], "a") as log:
    log.write(json.dumps({"args": args, "cwd": os.getcwd()}) + "\n")
if args == ["-vV"]:
    sys.stdout.write(fixture["version"])
elif args == ["--print", "target-list"]:
    # One triple without a fixture: rustc fails for it, and the checker must skip it.
    print("\n".join(sorted(fixture["targets"]) + ["unknown-fixture-target"]))
elif args[:3] == ["--print", "cfg", "--target"] and len(args) == 4 and args[3] in fixture["targets"]:
    sys.stdout.write(fixture["targets"][args[3]])
else:
    sys.stderr.write(f"fake rustc: no fixture for {args}\n")
    sys.exit(1)
